+void Fill::_create_vase_bottom_gap_fill(const Surface* /* surface */, const FillParams& params, ExtrusionEntityCollection* out)
+{
+    if (this->print_config == nullptr || params.config == nullptr)
+        return;
+    if (!this->print_config->spiral_mode || !this->print_config->vase_bottom_gap_fill)
+        return;
+    if (is_bridge(params.extrusion_role) || !is_solid_infill(params.extrusion_role))
+        return;
+    if (params.density < 1 || this->no_overlap_expolygons.empty())
         return;
 
+    const int bottom_layers = params.config->bottom_shell_layers.value;
+    if (bottom_layers <= 0)
+        return;
+
+    const int configured_layers = this->print_config->vase_bottom_gap_fill_layers.value;
+    const int layer_limit = configured_layers > 0 ? std::min(configured_layers, bottom_layers) : bottom_layers;
+    if (this->layer_id >= static_cast<size_t>(layer_limit))
+        return;
+
+    const double flow_ratio = this->print_config->vase_bottom_gap_fill_flow_ratio.value;
+    if (flow_ratio <= 0.)
+        return;
+
+    const coord_t scaled_mm = scale_(1.);
+    const double min_area = this->print_config->vase_bottom_gap_fill_min_area.value * double(scaled_mm) * double(scaled_mm);
+
