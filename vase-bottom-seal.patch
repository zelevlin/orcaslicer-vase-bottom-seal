+    // Apply flow_ratio by scaling mm3_per_mm
+    const float preview_width = float(new_flow.width() * std::min(flow_ratio, 2.0));
+    ExtrusionEntityCollection gap_fill_col;
+    variable_width(polylines, erGapFill, new_flow, gap_fill_col.entities);
+    if (flow_ratio != 1.0) {
+        for (ExtrusionEntity *e : gap_fill_col.entities) {
+            if (auto *path = dynamic_cast<ExtrusionPath*>(e)) {
+                path->mm3_per_mm *= float(flow_ratio);
+                path->width = preview_width;
+            }
         }
+    }
+    out->append(std::move(gap_fill_col.entities));
