+    ExPolygons residual = diff_ex(this->no_overlap_expolygons, union_ex(out->polygons_covered_by_spacing(10)));
+    residual = intersection_ex(union_ex(residual), this->no_overlap_expolygons);
+    if (residual.empty())
+        return;
