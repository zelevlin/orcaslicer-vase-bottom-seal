From 2651132978ea6e77e5990034ec99a516b6728f18 Mon Sep 17 00:00:00 2001
From: "evgenii.zelenkov" <evgenii.zelenkov@gdasuclite.com>
Date: Mon, 4 May 2026 21:32:59 +0300
Subject: [PATCH 6/6] fix: smart direction selection for micro void strokes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Replace fixed bbox-axis stroke with multi-candidate direction search:
1. Try infill angle (align with solid infill direction)
2. Try infill angle + 90°
3. Try long bbox axis
4. Try short bbox axis

Select the candidate with the longest intersection inside the void.
For elongated voids along walls this picks the correct axis instead
of crossing walls. For small compact voids a second pass without the
min_stroke threshold ensures they still get filled.

Removes the unclipped fallback stroke that was causing fills to exit
model boundaries.

Co-Authored-By: Claude Sonnet 4.6 (1M context) <noreply@anthropic.com>
---
 src/libslic3r/Fill/FillBase.cpp | 72 +++++++++++++++++++++++++++------
 1 file changed, 59 insertions(+), 13 deletions(-)

diff --git a/src/libslic3r/Fill/FillBase.cpp b/src/libslic3r/Fill/FillBase.cpp
index afe82abf4..a72438cb0 100644
--- a/src/libslic3r/Fill/FillBase.cpp
+++ b/src/libslic3r/Fill/FillBase.cpp
@@ -474,6 +474,21 @@ void Fill::_create_vase_bottom_micro_void_seal(const Surface* /* surface */, con
     const coord_t bbox_padding = coord_t(0.25 * extrusion_width);
     const float preview_width = float(params.flow.width() * std::min(flow_ratio, 2.0));
 
+    // Candidate angles to try for each void, in priority order:
+    // 1. infill angle (align with solid infill direction)
+    // 2. infill angle + 90° (perpendicular)
+    // 3. long bbox axis
+    // 4. short bbox axis
+    const double infill_angle = this->angle; // radians, set by Fill before calling us
+    const double cos_a = std::cos(infill_angle);
+    const double sin_a = std::sin(infill_angle);
+
+    auto make_seed_at_angle = [&](const Point &center, double ca, double sa, coord_t half_len) -> Polyline {
+        return Polyline(
+            Point(center.x() - coord_t(half_len * ca), center.y() - coord_t(half_len * sa)),
+            Point(center.x() + coord_t(half_len * ca), center.y() + coord_t(half_len * sa)));
+    };
+
     ExtrusionPaths seal_paths;
     for (const ExPolygon &ex : residual) {
         const double area = std::abs(ex.area());
@@ -489,21 +504,52 @@ void Fill::_create_vase_bottom_micro_void_seal(const Surface* /* surface */, con
         const Point center = bbox.center();
         const coord_t size_x = bbox.max.x() - bbox.min.x();
         const coord_t size_y = bbox.max.y() - bbox.min.y();
-        const bool horizontal = size_x >= size_y;
-        const coord_t half_len = std::max<coord_t>(min_stroke / 2, (horizontal ? size_x : size_y) / 2 + bbox_padding);
-
-        Polyline seed(horizontal ?
-            Point(center.x() - half_len, center.y()) :
-            Point(center.x(), center.y() - half_len),
-            horizontal ?
-            Point(center.x() + half_len, center.y()) :
-            Point(center.x(), center.y() + half_len));
+        const coord_t long_half  = std::max(size_x, size_y) / 2 + bbox_padding;
+        const coord_t short_half = std::min(size_x, size_y) / 2 + bbox_padding;
+        const coord_t half_len   = std::max<coord_t>(min_stroke / 2, long_half);
+
+        // Build candidate seeds in priority order
+        struct Candidate { double ca, sa; coord_t hl; };
+        const Candidate candidates[] = {
+            { cos_a,  sin_a,  half_len },                    // infill angle
+            { -sin_a, cos_a,  half_len },                    // infill angle + 90°
+            { size_x >= size_y ? 1. : 0., size_x >= size_y ? 0. : 1., half_len },  // long bbox axis
+            { size_x >= size_y ? 0. : 1., size_x >= size_y ? 1. : 0., std::max<coord_t>(min_stroke / 2, short_half) }, // short bbox axis
+        };
 
-        Polylines clipped = intersection_pl(seed, ex);
-        if (clipped.empty() || total_length(clipped) < min_stroke)
-            clipped = { std::move(seed) };
+        Polylines best;
+        double best_len = 0.;
+        for (const auto &c : candidates) {
+            Polyline seed = make_seed_at_angle(center, c.ca, c.sa, c.hl);
+            Polylines clipped = intersection_pl(seed, ex);
+            if (clipped.empty()) continue;
+            double len = total_length(clipped);
+            if (len >= min_stroke && len > best_len) {
+                best_len = len;
+                best = std::move(clipped);
+            }
+        }
+        // For small compact voids none of the candidates may reach min_stroke.
+        // Fall back to the longest intersection found (any length > 0) so small
+        // round holes still get filled without crossing walls.
+        if (best.empty()) {
+            for (const auto &c : candidates) {
+                Polyline seed = make_seed_at_angle(center, c.ca, c.sa, c.hl);
+                Polylines clipped = intersection_pl(seed, ex);
+                if (clipped.empty()) continue;
+                double len = total_length(clipped);
+                if (len > best_len) {
+                    best_len = len;
+                    best = std::move(clipped);
+                }
+            }
+        }
+        // If no candidate produced a valid clipped stroke, skip this void entirely
+        // (no fallback to unclipped stroke that would cross walls)
+        if (best.empty())
+            continue;
 
-        for (Polyline &polyline : clipped) {
+        for (Polyline &polyline : best) {
             if (polyline.length() <= 0.)
                 continue;
             ExtrusionPath path(erGapFill, params.flow.mm3_per_mm() * flow_ratio, preview_width, params.flow.height());
