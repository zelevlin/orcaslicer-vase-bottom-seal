-            variable_width(polylines, erGapFill, params.flow, gap_fill.entities);
-            auto gap = std::move(gap_fill.entities);
-            out->append(gap);
+    const int configured_layers = this->print_config->vase_bottom_micro_void_layers.value;
+    const int layer_limit = configured_layers > 0 ? std::min(configured_layers, bottom_layers) : bottom_layers;
+    if (this->layer_id >= static_cast<size_t>(layer_limit))
+        return;
+
+    const double flow_ratio = this->print_config->vase_bottom_micro_void_flow_ratio.value;
+    if (flow_ratio <= 0.)
+        return;
+
+    const coord_t scaled_mm = scale_(1.);
+    const double max_area = this->print_config->vase_bottom_micro_void_max_area.value * double(scaled_mm) * double(scaled_mm);
+    if (max_area <= 0.)
+        return;
+
+    ExPolygons residual = diff_ex(this->no_overlap_expolygons, union_ex(out->polygons_covered_by_width(10.f)));
+    if (residual.empty())
+        return;
+    residual = intersection_ex(union_ex(residual), this->no_overlap_expolygons);
+
+    const coord_t extrusion_width = scale_(params.flow.width());
+    const coord_t min_stroke = std::max<coord_t>(scale_(0.05), coord_t(0.35 * extrusion_width));
+    const coord_t bbox_padding = coord_t(0.25 * extrusion_width);
+    const float preview_width = float(params.flow.width() * std::min(flow_ratio, 2.0));
+
+    ExtrusionPaths seal_paths;
+    for (const ExPolygon &ex : residual) {
+        if (ex.empty() || std::abs(ex.area()) > max_area)
+            continue;
+
+        const BoundingBox bbox = get_extents(ex);
+        if (!bbox.defined)
+            continue;
+
+        const Point center = bbox.center();
+        const coord_t size_x = bbox.max.x() - bbox.min.x();
+        const coord_t size_y = bbox.max.y() - bbox.min.y();
+        const bool horizontal = size_x >= size_y;
+        const coord_t half_len = std::max<coord_t>(min_stroke / 2, (horizontal ? size_x : size_y) / 2 + bbox_padding);
+
+        Polyline seed(horizontal ?
+            Point(center.x() - half_len, center.y()) :
+            Point(center.x(), center.y() - half_len),
+            horizontal ?
+            Point(center.x() + half_len, center.y()) :
+            Point(center.x(), center.y() + half_len));
+
+        Polylines clipped = intersection_pl(seed, ex);
+        if (clipped.empty() || total_length(clipped) < min_stroke)
+            clipped = { std::move(seed) };
