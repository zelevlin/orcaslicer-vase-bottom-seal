+void Fill::_create_vase_bottom_micro_void_seal(const Surface* /* surface */, const FillParams& params, ExtrusionEntityCollection* out)
+{
+    if (this->print_config == nullptr || params.config == nullptr)
+        return;
+    if (!this->print_config->spiral_mode || !this->print_config->vase_bottom_micro_void_seal)
+        return;
+    if (is_bridge(params.extrusion_role) || !is_solid_infill(params.extrusion_role))
+        return;
+    if (params.density < 1 || this->no_overlap_expolygons.empty())
+        return;
 
